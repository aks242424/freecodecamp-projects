# Auto-detect text files and perform LF normalization
* text=auto

# Declare explicit text files to enforce LF line endings
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf

# Declare binary files (Git will not try to merge or fix line endings for these)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
